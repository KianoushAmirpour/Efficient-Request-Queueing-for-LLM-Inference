# Ansible-managed SSH hardening configuration
Port {{ sshd_port }}
PermitRootLogin {{ ssh_hardening_sshd_permit_root_login }}
PasswordAuthentication {{ ssh_hardening_sshd_password_authentication }}
KbdInteractiveAuthentication {{ ssh_hardening_sshd_kbd_interactive_authentication }}
PubkeyAuthentication {{ ssh_hardening_sshd_pubkey_authentication }}
PermitEmptyPasswords {{ ssh_hardening_sshd_permit_empty_passwords }}
MaxAuthTries {{ ssh_hardening_sshd_max_auth_tries }}
LoginGraceTime {{ ssh_hardening_sshd_login_grace_time }}
MaxStartups {{ ssh_hardening_sshd_max_startups }}
MaxSessions {{ ssh_hardening_sshd_max_sessions }}
ClientAliveInterval {{ ssh_hardening_sshd_client_alive_interval }}
ClientAliveCountMax {{ ssh_hardening_sshd_client_alive_count_max }}
AllowAgentForwarding {{ ssh_hardening_sshd_allow_agent_forwarding }}
AllowTcpForwarding {{ ssh_hardening_sshd_allow_tcp_forwarding }}
AllowStreamLocalForwarding {{ ssh_hardening_sshd_allow_stream_local_forwarding }}
X11Forwarding {{ ssh_hardening_sshd_x11_forwarding }}
PermitTunnel {{ ssh_hardening_sshd_permit_tunnel }}
PermitUserEnvironment {{ ssh_hardening_sshd_permit_user_environment }}
GSSAPIAuthentication {{ ssh_hardening_sshd_gssapi_authentication }}
HostbasedAuthentication {{ ssh_hardening_sshd_hostbased_authentication }}
IgnoreRhosts {{ ssh_hardening_sshd_ignore_rhosts }}
StrictModes {{ ssh_hardening_sshd_strict_modes }}
UsePAM {{ ssh_hardening_sshd_use_pam }}
LogLevel {{ ssh_hardening_sshd_log_level }}
AllowUsers {{ ssh_hardening_sshd_allowed_users | join(' ') }}